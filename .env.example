# Optional third-party API configuration for Koplingfy.
# Configure these securely in the AI Studio Secrets panel or local .env (never commit .env).
# Core providers (Audius, YouTube Music via Piped/Invidious, Radio Browser, LRCLIB, ML Kit Translation, Local MediaStore) work out-of-the-box without API keys.

# JAMENDO_CLIENT_ID: Optional Jamendo Developer API client_id (https://devportal.jamendo.com/)
# JAMENDO_CLIENT_ID=your_jamendo_client_id

# MUSIXMATCH_API_KEY: Optional licensed Musixmatch API key for additional lyrics
# MUSIXMATCH_API_KEY=your_musixmatch_api_key

# GOOGLE_TRANSLATE_API_KEY: Optional Google Cloud Translation API key (ML Kit on-device works free without key)
# GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key
